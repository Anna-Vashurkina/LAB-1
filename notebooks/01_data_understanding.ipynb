    "# 2. Паспорт датасета (Data Understanding)\n",
   import pandas as pd

# 1. Загрузка данных в pandas DataFrame
print("--- 1. Загрузка данных ---")
df = pd.read_csv('../data/full_dataset.csv')
print("Данные успешно загружены!\n")

# 2. Определение размера датасета (количество строк и столбцов)
print("--- 2. Размер датасета ---")
rows_count, cols_count = df.shape
print(f"Количество строк (объектов): {rows_count}")
print(f"Количество столбцов (признаков): {cols_count}\n")

# 3. Вывод списка всех признаков, их типов и предварительного смысла
print("--- 3. Паспорт признаков (типы и описание) ---")
passport_df = pd.DataFrame({
    'Название признака': df.columns,
    'Тип данных (pandas)': df.dtypes.values,
    'Количество непустых строк': df.notnull().sum().values,
    'Доля пропусков (%)': (df.isnull().mean().values * 100).round(1)
})

# Выводим таблицу паспорта
display(passport_df)
